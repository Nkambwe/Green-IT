@page "{id:int}"
@model GreenIT.Web.Pages.Assets.DetailsModel

@{
    ViewData["Title"] = "Asset Details";

    var statusClass = Model.Asset.Status switch
    {
        GreenIT.Domain.Enums.AssetStatus.InUse => "bg-success",
        GreenIT.Domain.Enums.AssetStatus.InStorage => "bg-info text-dark",
        GreenIT.Domain.Enums.AssetStatus.UnderMaintenance => "bg-warning text-dark",
        GreenIT.Domain.Enums.AssetStatus.Retired => "bg-secondary",
        GreenIT.Domain.Enums.AssetStatus.Disposed => "bg-danger",
        _ => "bg-secondary"
    };

    var conditionClass = Model.Asset.Condition switch
    {
        GreenIT.Domain.Enums.AssetCondition.Excellent => "text-success",
        GreenIT.Domain.Enums.AssetCondition.Good => "text-success",
        GreenIT.Domain.Enums.AssetCondition.Fair => "text-warning",
        GreenIT.Domain.Enums.AssetCondition.Poor => "text-danger",
        GreenIT.Domain.Enums.AssetCondition.BeyondRepair => "text-danger",
        _ => "text-muted"
    };
}

<!-- Page Heading -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Asset Details</h4>
        <p class="text-muted mb-0">
            View complete information about this IT asset.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-page="./Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Inventory
        </a>

        <a asp-page="./Edit"
           asp-route-id="@Model.Asset.Id"
           class="btn btn-success">
            <i class="bi bi-pencil me-1"></i>
            Edit Asset
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null) {
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<!-- Asset Overview -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

            <div>
                <span class="text-muted small">ASSET TAG</span>

                <h3 class="fw-bold mt-1 mb-2">
                    @Model.Asset.AssetTag
                </h3>

                <h5 class="mb-1">@Model.Asset.Name</h5>

                <span class="text-muted">
                    @Model.Asset.Category
                </span>
            </div>

            <div class="text-md-end">
                <span class="badge @statusClass fs-6 mb-2">
                    @Model.Asset.Status
                </span>

                <div class="small">
                    <span class="text-muted">Condition:</span>
                    <strong class="@conditionClass">
                        @Model.Asset.Condition
                    </strong>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="row g-4">

    <!-- Asset Identification -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-pc-display me-2 text-success"></i>
                    Asset Identification
                </h5>
            </div>

            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-5 text-muted">Asset Tag</div>
                    <div class="col-7 fw-semibold">
                        @Model.Asset.AssetTag
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-5 text-muted">Asset Name</div>
                    <div class="col-7 fw-semibold">
                        @Model.Asset.Name
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-5 text-muted">Serial Number</div>
                    <div class="col-7">
                        @(Model.Asset.SerialNumber ?? "-")
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-5 text-muted">Category</div>
                    <div class="col-7">
                        @Model.Asset.Category
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-5 text-muted">Manufacturer</div>
                    <div class="col-7">
                        @(Model.Asset.Manufacturer ?? "-")
                    </div>
                </div>

                <div class="row">
                    <div class="col-5 text-muted">Model</div>
                    <div class="col-7">
                        @(Model.Asset.Model ?? "-")
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Department and Location -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-building me-2 text-success"></i>
                    Department and Location
                </h5>
            </div>

            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-5 text-muted">Department</div>
                    <div class="col-7 fw-semibold">
                        @Model.Asset.Department?.Name
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-5 text-muted">Department Code</div>
                    <div class="col-7">
                        @Model.Asset.Department?.Code
                    </div>
                </div>

                <div class="row">
                    <div class="col-5 text-muted">Physical Location</div>
                    <div class="col-7">
                        @(Model.Asset.Location ?? "-")
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Purchase and Warranty -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-receipt me-2 text-success"></i>
                    Purchase and Warranty
                </h5>
            </div>

            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-5 text-muted">Purchase Date</div>
                    <div class="col-7">
                        @(Model.Asset.PurchaseDate?.ToString("dd MMM yyyy") ?? "-")
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-5 text-muted">Purchase Cost</div>
                    <div class="col-7 fw-semibold">
                        @(Model.Asset.PurchaseCost?.ToString("N2") ?? "-")
                    </div>
                </div>

                <div class="row">
                    <div class="col-5 text-muted">Warranty Expiry</div>
                    <div class="col-7">
                        @(Model.Asset.WarrantyExpiryDate?.ToString("dd MMM yyyy") ?? "-")
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- System Information -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">

            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-clock-history me-2 text-success"></i>
                    System Information
                </h5>
            </div>

            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-5 text-muted">Registered On</div>
                    <div class="col-7">
                        @Model.Asset.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")
                    </div>
                </div>

                <div class="row">
                    <div class="col-5 text-muted">Last Updated</div>
                    <div class="col-7">
                        @(Model.Asset.UpdatedAtUtc?.ToString("dd MMM yyyy HH:mm") ?? "Never updated")
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Notes -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-card-text me-2 text-success"></i>
                    Additional Notes
                </h5>
            </div>

            <div class="card-body">
                @if (string.IsNullOrWhiteSpace(Model.Asset.Notes)) {
                    <span class="text-muted">No additional notes recorded.</span>
                } else {
                    <p class="mb-0" style="white-space: pre-wrap;">@Model.Asset.Notes</p>
                }
            </div>

        </div>
    </div>

</div>

<!-- Assignment History -->
<div class="card border-0 shadow-sm mt-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0">
                <i class="bi bi-clock-history me-2 text-success"></i>
                Assignment History
            </h5>
            <small class="text-muted">Previous and current assignments for this asset.</small>
        </div>
        <span class="badge bg-light text-dark">
            @Model.AssignmentHistory.Count record(s)
        </span>
    </div>

    <div class="card-body p-0">
        @if (Model.AssignmentHistory.Any()) {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Department</th>
                            <th>Assigned To</th>
                            <th>Assigned Date</th>
                            <th>Returned Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in Model.AssignmentHistory) {
                            <tr>
                                <td class="ps-3 fw-semibold">
                                    @(assignment.Department?.Name ?? "-")
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(assignment.AssignedToUserId)
                                        ? "Not specified"
                                        : assignment.AssignedToUserId)
                                </td>
                                <td>@assignment.AssignedDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @(assignment.ReturnedDate?.ToString("dd MMM yyyy") ?? "-")
                                </td>
                                <td>
                                    @if (assignment.ReturnedDate == null) {
                                        <span class="badge bg-success">Active</span>
                                    } else {
                                        <span class="badge bg-secondary">Closed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        } else {
            <div class="text-center py-4">
                <i class="bi bi-inbox text-muted fs-2"></i>
                <p class="text-muted mb-0 mt-2">No assignment history recorded for this asset.</p>
            </div>
        }
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4 mb-4">

    <a asp-page="./Index"
       class="btn btn-outline-secondary">
        Back to Inventory
    </a>

    <a asp-page="./Edit"
       asp-route-id="@Model.Asset.Id"
       class="btn btn-success">
        Edit Asset
    </a>

</div>
