@page "{id:int}"
@model GreenIT.Web.Pages.Assets.EditModel

@{
    ViewData["Title"] = "Edit Asset";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Edit Asset</h4>
        <p class="text-muted mb-0">
            Update the information for this registered IT asset.
        </p>
    </div>

    <a asp-page="./Details"
       asp-route-id="@RouteData.Values["id"]"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Details
    </a>
</div>

<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert"></div>

    <!-- Asset Identification -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Asset Identification</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="Input.AssetTag" class="form-label">
                        Asset Tag <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Input.AssetTag"
                           class="form-control" />

                    <span asp-validation-for="Input.AssetTag"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.SerialNumber"
                           class="form-label">
                        Serial Number
                    </label>

                    <input asp-for="Input.SerialNumber"
                           class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Name" class="form-label">
                        Asset Name <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Input.Name"
                           class="form-control" />

                    <span asp-validation-for="Input.Name"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Category"
                           class="form-label">
                        Asset Category
                    </label>

                    <select asp-for="Input.Category"
                            asp-items="Model.Categories"
                            class="form-select">
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Manufacturer"
                           class="form-label">
                        Manufacturer
                    </label>

                    <input asp-for="Input.Manufacturer"
                           class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Model" class="form-label">
                        Model
                    </label>

                    <input asp-for="Input.Model"
                           class="form-control" />
                </div>

            </div>
        </div>
    </div>

    <!-- Department and Location -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Department and Location</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="Input.DepartmentId"
                           class="form-label">
                        Department <span class="text-danger">*</span>
                    </label>

                    <select asp-for="Input.DepartmentId"
                            asp-items="Model.Departments"
                            class="form-select">
                        <option value="">Select Department</option>
                    </select>

                    <span asp-validation-for="Input.DepartmentId"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Location"
                           class="form-label">
                        Physical Location
                    </label>

                    <input asp-for="Input.Location"
                           class="form-control" />
                </div>

            </div>
        </div>
    </div>

    <!-- Condition and Status -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Asset Condition and Status</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="Input.Condition"
                           class="form-label">
                        Asset Condition
                    </label>

                    <select asp-for="Input.Condition"
                            asp-items="Model.Conditions"
                            class="form-select">
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Status"
                           class="form-label">
                        Asset Status
                    </label>

                    <select asp-for="Input.Status"
                            asp-items="Model.Statuses"
                            class="form-select">
                    </select>
                </div>

            </div>
        </div>
    </div>

    <!-- Purchase Information -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                Purchase and Warranty Information
            </h5>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-4">
                    <label asp-for="Input.PurchaseDate"
                           class="form-label">
                        Purchase Date
                    </label>

                    <input asp-for="Input.PurchaseDate"
                           type="date"
                           class="form-control" />
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.WarrantyExpiryDate"
                           class="form-label">
                        Warranty Expiry Date
                    </label>

                    <input asp-for="Input.WarrantyExpiryDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Input.WarrantyExpiryDate"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.PurchaseCost"
                           class="form-label">
                        Purchase Cost
                    </label>

                    <input asp-for="Input.PurchaseCost"
                           type="number"
                           min="0"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="Input.PurchaseCost"
                          class="text-danger small"></span>
                </div>

            </div>
        </div>
    </div>

    <!-- Notes -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Additional Notes</h5>
        </div>

        <div class="card-body">
            <label asp-for="Input.Notes" class="form-label">
                Notes
            </label>

            <textarea asp-for="Input.Notes"
                      class="form-control"
                      rows="3"></textarea>
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-end gap-2 mb-4">

        <a asp-page="./Details"
           asp-route-id="@RouteData.Values["id"]"
           class="btn btn-outline-secondary">
            Cancel
        </a>

        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle me-1"></i>
            Update Asset
        </button>

    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
