@page
@model GreenIT.Web.Pages.Assets.IndexModel

@{
    ViewData["Title"] = "IT Assets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">IT Asset Management</h4>
        <p class="text-muted mb-0">
            Manage and monitor organisational IT assets.
        </p>
    </div>

    <a asp-page="./Create" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i>
        Register Asset
    </a>
</div>

<!-- Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <small class="text-muted">Total Registered Assets</small>
            <h4 class="fw-bold mb-0 mt-2">@Model.TotalRecords.ToString("N0")</h4>
            <small class="text-muted">Matching current filters</small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <small class="text-muted">Current Page</small>
            <h4 class="fw-bold mb-0 mt-2">
                @(Model.TotalPages == 0 ? 0 : Model.PageNumber)
                <span class="text-muted fs-6">of @Model.TotalPages</span>
            </h4>
            <small class="text-muted">Inventory pages</small>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <small class="text-muted">Records Displayed</small>
            <h4 class="fw-bold mb-0 mt-2">@Model.Assets.Count</h4>
            <small class="text-muted">On this page</small>
        </div>
    </div>
</div>

<!-- Search and Filters -->
<div class="card border-0 shadow-sm p-3 mb-4">
    <form method="get" class="row g-3 align-items-end">

        <div class="col-lg-3 col-md-6">
            <label asp-for="SearchTerm" class="form-label">
                Search Assets
            </label>
            <input asp-for="SearchTerm"
                   class="form-control"
                   placeholder="Asset tag, name, serial number..." />
        </div>

        <div class="col-lg-2 col-md-6">
            <label asp-for="DepartmentFilter" class="form-label">
                Department
            </label>
            <select asp-for="DepartmentFilter"
                    asp-items="Model.DepartmentOptions"
                    class="form-select">
                <option value="">All Departments</option>
            </select>
        </div>

        <div class="col-lg-2 col-md-6">
            <label asp-for="CategoryFilter" class="form-label">
                Category
            </label>
            <select asp-for="CategoryFilter"
                    asp-items="Model.CategoryOptions"
                    class="form-select">
                <option value="">All Categories</option>
            </select>
        </div>

        <div class="col-lg-2 col-md-6">
            <label asp-for="StatusFilter" class="form-label">
                Status
            </label>
            <select asp-for="StatusFilter"
                    asp-items="Model.StatusOptions"
                    class="form-select">
                <option value="">All Statuses</option>
            </select>
        </div>

        <div class="col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-search me-1"></i>
                Search
            </button>

            <a asp-page="./Index" class="btn btn-outline-secondary">
                Reset
            </a>
        </div>

    </form>
</div>

<!-- Asset Inventory -->
<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Asset Inventory</h5>
            <span class="text-muted small">
                @Model.TotalRecords.ToString("N0") records found
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th>Asset Tag</th>
                    <th>Asset Name</th>
                    <th>Category</th>
                    <th>Department</th>
                    <th>Location</th>
                    <th>Condition</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Assets.Count == 0) {
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No assets found.
                            </div>
                        </td>
                    </tr>
                } else {
                    @foreach (var asset in Model.Assets) {
                        <tr>
                            <td class="fw-semibold">
                                @asset.AssetTag
                            </td>

                            <td>
                                <div class="fw-semibold">@asset.Name</div>
                                <small class="text-muted">
                                    @(asset.Manufacturer ?? "-")
                                    @(asset.Model ?? "")
                                </small>
                            </td>

                            <td>@asset.Category</td>

                            <td>@asset.Department?.Name</td>

                            <td>@(asset.Location ?? "-")</td>

                            <td>@asset.Condition</td>

                            <td>
                                @{
                                    var statusClass = asset.Status switch
                                    {
                                        AssetStatus.InUse => "bg-success",
                                        AssetStatus.InStorage => "bg-info text-dark",
                                        AssetStatus.UnderMaintenance => "bg-warning text-dark",
                                        AssetStatus.Retired => "bg-secondary",
                                        AssetStatus.Disposed => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }

                                <span class="badge @statusClass">
                                    @asset.Status
                                </span>
                            </td>

                            <td class="text-end">
                                <a asp-page="./Details"
                                   asp-route-id="@asset.Id"
                                   class="btn btn-sm btn-outline-success">
                                    View
                                </a>

                                <a asp-page="./Edit"
                                   asp-route-id="@asset.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="card-footer bg-white py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <small class="text-muted">
                Showing @Model.StartRecord–@Model.EndRecord
                of @Model.TotalRecords records
            </small>

            @if (Model.TotalPages > 1) {
                <nav aria-label="Asset pagination">
                    <ul class="pagination pagination-sm mb-0">

                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-PageNumber="@(Model.PageNumber - 1)"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-DepartmentFilter="@Model.DepartmentFilter"
                               asp-route-CategoryFilter="@Model.CategoryFilter"
                               asp-route-StatusFilter="@Model.StatusFilter">
                                Previous
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++) {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   asp-page="./Index"
                                   asp-route-PageNumber="@i"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-DepartmentFilter="@Model.DepartmentFilter"
                                   asp-route-CategoryFilter="@Model.CategoryFilter"
                                   asp-route-StatusFilter="@Model.StatusFilter">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-PageNumber="@(Model.PageNumber + 1)"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-DepartmentFilter="@Model.DepartmentFilter"
                               asp-route-CategoryFilter="@Model.CategoryFilter"
                               asp-route-StatusFilter="@Model.StatusFilter">
                                Next
                            </a>
                        </li>

                    </ul>
                </nav>
            }
        </div>
    </div>

</div>
