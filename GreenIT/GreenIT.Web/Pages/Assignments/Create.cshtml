@page
@model GreenIT.Web.Pages.Assignments.CreateModel

@{
    ViewData["Title"] = "New Asset Assignment";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">New Asset Assignment</h4>
        <p class="text-muted mb-0">
            Allocate an available IT asset to a department or staff member.
        </p>
    </div>

    <a asp-page="./Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Assignments
    </a>
</div>

<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"></div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Assignment Information</h5>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="Input.ITAssetId"
                           class="form-label">
                        Select Asset <span class="text-danger">*</span>
                    </label>

                    <select asp-for="Input.ITAssetId"
                            asp-items="Model.Assets"
                            class="form-select">
                        <option value="">Select an available asset</option>
                    </select>

                    <span asp-validation-for="Input.ITAssetId"
                          class="text-danger small"></span>

                    @if (!Model.Assets.Any()) {
                        <small class="text-muted">
                            No available assets found.
                        </small>
                    }
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.DepartmentId"
                           class="form-label">
                        Receiving Department <span class="text-danger">*</span>
                    </label>

                    <select asp-for="Input.DepartmentId"
                            asp-items="Model.Departments"
                            class="form-select">
                        <option value="">Select department</option>
                    </select>

                    <span asp-validation-for="Input.DepartmentId"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.AssignedToUserId"
                           class="form-label">
                        Staff Member
                    </label>

                    <input asp-for="Input.AssignedToUserId"
                           class="form-control"
                           placeholder="Enter staff user ID" />

                    <small class="text-muted">
                        Enter the staff member's Identity user ID.
                    </small>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.AssignedDate"
                           class="form-label">
                        Assignment Date
                    </label>

                    <input asp-for="Input.AssignedDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Input.AssignedDate"
                          class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Input.Notes"
                           class="form-label">
                        Notes
                    </label>

                    <textarea asp-for="Input.Notes"
                              class="form-control"
                              rows="3"
                              placeholder="Enter assignment remarks...">
                    </textarea>
                </div>

            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-4">
        <a asp-page="./Index"
           class="btn btn-outline-secondary">
            Cancel
        </a>

        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle me-1"></i>
            Save Assignment
        </button>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
