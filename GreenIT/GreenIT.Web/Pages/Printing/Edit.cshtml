@page "{id:int}"
@model GreenIT.Web.Pages.Printing.EditModel

@{
    ViewData["Title"] = "Edit Printing Record";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">Edit Printing Record</h4>
        <p class="text-muted mb-0">
            Update the department's printing information.
        </p>
    </div>

    <a asp-page="./Details"
       asp-route-id="@Model.Input.Id"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Details
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <form method="post">
            <input type="hidden" asp-for="Input.Id" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert"></div>

            <h6 class="mb-3">Reporting Information</h6>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Input.DepartmentId"
                           class="form-label">Department</label>

                    <select asp-for="Input.DepartmentId"
                            asp-items="Model.Departments"
                            class="form-select">
                        <option value="">Select Department</option>
                    </select>

                    <span asp-validation-for="Input.DepartmentId"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.Year"
                           class="form-label">Reporting Year</label>

                    <input asp-for="Input.Year"
                           type="number"
                           class="form-control" />

                    <span asp-validation-for="Input.Year"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.Month"
                           class="form-label">Reporting Month</label>

                    <select asp-for="Input.Month"
                            asp-items="Model.Months"
                            class="form-select">
                        <option value="">Select Month</option>
                    </select>

                    <span asp-validation-for="Input.Month"
                          class="text-danger small"></span>
                </div>
            </div>

            <hr />

            <h6 class="mb-3">Printing Statistics</h6>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Input.TotalPages"
                           class="form-label">Total Pages</label>

                    <input asp-for="Input.TotalPages"
                           type="number"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="Input.TotalPages"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.PrintJobs"
                           class="form-label">Number of Print Jobs</label>

                    <input asp-for="Input.PrintJobs"
                           type="number"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="Input.PrintJobs"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.DuplexPages"
                           class="form-label">Duplex Pages</label>

                    <input asp-for="Input.DuplexPages"
                           type="number"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="Input.DuplexPages"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.ColourPages"
                           class="form-label">Colour Pages</label>

                    <input asp-for="Input.ColourPages"
                           type="number"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="Input.ColourPages"
                          class="text-danger small"></span>
                </div>
            </div>

            <hr />

            <h6 class="mb-3">Additional Information</h6>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Input.Source"
                           class="form-label">Source</label>

                    <input asp-for="Input.Source"
                           maxlength="150"
                           class="form-control" />

                    <span asp-validation-for="Input.Source"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Created At (UTC)</label>

                    <input value="@Model.Input.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")"
                           class="form-control"
                           readonly />
                </div>

                <div class="col-12">
                    <label asp-for="Input.Notes"
                           class="form-label">Notes</label>

                    <textarea asp-for="Input.Notes"
                              maxlength="1000"
                              rows="3"
                              class="form-control"></textarea>

                    <span asp-validation-for="Input.Notes"
                          class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-page="./Details"
                   asp-route-id="@Model.Input.Id"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i>
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
