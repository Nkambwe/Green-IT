@page
@model GreenIT.Web.Pages.Printing.IndexModel

@{
    ViewData["Title"] = "Paper & Printing";

    var duplexPercentage = Model.TotalPagesPrinted > 0
        ? Math.Round(
            (double)Model.TotalDuplexPages /
            Model.TotalPagesPrinted * 100, 1)
        : 0;
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Paper & Printing</h4>
        <p class="text-muted mb-0">
            Monitor departmental printing activity and paper consumption.
        </p>
    </div>

    <a asp-page="Create" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i>
        Add Printing Record
    </a>
</div>

@if (TempData["SuccessMessage"] != null) {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

<!-- Summary cards -->
<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small">Printing Records</div>
                <h3 class="fw-bold text-success mb-0">
                    @Model.TotalRecords.ToString("N0")
                </h3>
                <small class="text-muted">Matching records</small>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small">Total Pages Printed</div>
                <h3 class="fw-bold text-success mb-0">
                    @Model.TotalPagesPrinted.ToString("N0")
                </h3>
                <small class="text-muted">Pages recorded</small>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small">Duplex Pages</div>
                <h3 class="fw-bold text-success mb-0">
                    @Model.TotalDuplexPages.ToString("N0")
                </h3>
                <small class="text-muted">
                    @duplexPercentage% of total pages
                </small>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="text-muted small">Colour Pages</div>
                <h3 class="fw-bold text-success mb-0">
                    @Model.TotalColourPages.ToString("N0")
                </h3>
                <small class="text-muted">Colour printing recorded</small>
            </div>
        </div>
    </div>

</div>

<!-- Printing records -->
<div class="card shadow-sm border-0">

    <div class="card-header bg-white py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0 fw-bold">Printing Records</h5>

            <form method="get" class="d-flex gap-2">
                <input asp-for="SearchTerm"
                       class="form-control form-control-sm"
                       placeholder="Search department or period..."
                       style="min-width:230px;" />

                <button type="submit" class="btn btn-sm btn-success">
                    <i class="bi bi-search"></i>
                </button>

                <a asp-page="Index" class="btn btn-sm btn-light border">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </form>
        </div>
    </div>

    <div class="card-body p-0">

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Department</th>
                        <th>Reporting Period</th>
                        <th class="text-end">Total Pages</th>
                        <th class="text-end">Duplex Pages</th>
                        <th class="text-end">Colour Pages</th>
                        <th class="text-end">Print Jobs</th>
                        <th>Source</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Records.Any()) {
                        foreach (var record in Model.Records) {
                            <tr>
                                <td class="ps-3 fw-semibold">
                                    @record.Department.Name
                                </td>

                                <td>
                                    @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(record.Month)
                                    @record.Year
                                </td>

                                <td class="text-end">
                                    @record.TotalPages.ToString("N0")
                                </td>

                                <td class="text-end">
                                    @record.DuplexPages.ToString("N0")
                                </td>

                                <td class="text-end">
                                    @record.ColourPages.ToString("N0")
                                </td>

                                <td class="text-end">
                                    @record.PrintJobs.ToString("N0")
                                </td>

                                <td>
                                    @if (record.Source == "DEMO-SEED") {
                                        <span class="badge bg-secondary">
                                            Demo
                                        </span>
                                    } else {
                                        <span class="text-muted small">
                                            @(string.IsNullOrWhiteSpace(record.Source)
                                                ? "—"
                                                : record.Source)
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    <a asp-page="Details"
                                       asp-route-id="@record.Id"
                                       class="btn btn-sm btn-light border"
                                       title="View details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-page="./Delete"
                                       asp-route-id="@record.Id"
                                       class="btn btn-sm btn-outline-danger"
                                       title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    } else {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <i class="bi bi-printer fs-2 text-muted"></i>
                                <p class="text-muted mt-2 mb-0">
                                    No printing records found.
                                </p>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>

    @if (Model.TotalPages > 1) {
        <div class="card-footer bg-white">
            <div class="d-flex justify-content-between align-items-center">

                <small class="text-muted">
                    Page @Model.PageNumber of @Model.TotalPages
                </small>

                <div class="btn-group">

                    <a asp-page="Index"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-PageNumber="@(Model.PageNumber - 1)"
                       class="btn btn-sm btn-outline-success @(Model.PageNumber <= 1 ? "disabled" : "")">
                        Previous
                    </a>

                    <a asp-page="Index"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-PageNumber="@(Model.PageNumber + 1)"
                       class="btn btn-sm btn-outline-success @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        Next
                    </a>

                </div>
            </div>
        </div>
    }

</div>
