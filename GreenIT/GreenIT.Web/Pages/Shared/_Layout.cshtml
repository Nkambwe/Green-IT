<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Green IT</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GreenIT.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">G</div>
                <div>
                    <div class="brand-name">GreenIT</div>
                    <small>Resource Efficiency</small>
                </div>
            </div>

            <div class="sidebar-section">
                <span class="sidebar-label">MAIN MENU</span>

                <a asp-page="/Index" class="sidebar-link active">
                    <span class="menu-icon">▦</span>
                    Dashboard
                </a>
            </div>

            <div class="sidebar-section">
                <span class="sidebar-label">MANAGEMENT</span>

                <div class="sidebar-link disabled">
                    <span class="menu-icon">▣</span>
                    IT Assets
                    <span class="menu-soon">Soon</span>
                </div>

                <div class="sidebar-link disabled">
                    <span class="menu-icon">ϟ</span>
                    Energy Monitoring
                    <span class="menu-soon">Soon</span>
                </div>

                <div class="sidebar-link disabled">
                    <span class="menu-icon">▤</span>
                    Paper & Printing
                    <span class="menu-soon">Soon</span>
                </div>

                <div class="sidebar-link disabled">
                    <span class="menu-icon">✓</span>
                    Sustainability Actions
                    <span class="menu-soon">Soon</span>
                </div>
            </div>

            <div class="sidebar-section">
                <span class="sidebar-label">SYSTEM</span>

                <div class="sidebar-link disabled">
                    <span class="menu-icon">▧</span>
                    Reports
                    <span class="menu-soon">Soon</span>
                </div>

                <div class="sidebar-link disabled">
                    <span class="menu-icon">⚙</span>
                    Administration
                    <span class="menu-soon">Soon</span>
                </div>
            </div>

            <div class="sidebar-footer">
                <div class="system-status"></div>
                <div>
                    <strong>GreenIT System</strong>
                    <small>Development Environment</small>
                </div>
            </div>
        </aside>

        <div class="main-area">

            <header class="topbar">
                <button class="menu-toggle"
                        type="button"
                        onclick="toggleSidebar()">
                    ☰
                </button>

                <div class="topbar-title">
                    <strong>Resource Efficiency Platform</strong>
                    <small>Environmental sustainability monitoring</small>
                </div>

                <div class="topbar-user">
                    <div class="user-avatar">A</div>
                    <div class="user-details">
                        <strong>Administrator</strong>
                        <small>System Administrator</small>
                    </div>
                </div>
            </header>

            <main class="content-area">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>© @DateTime.UtcNow.Year GreenIT</span>
                <span>Green Computing & Resource Efficiency</span>
            </footer>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            function toggleSidebar() {
                document.getElementById("sidebar")
                    .classList.toggle("sidebar-open");
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>