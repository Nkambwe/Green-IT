@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    var isDashboard = currentPage.Equals(
        "/Index", StringComparison.OrdinalIgnoreCase);

    var isAssets = currentPage.StartsWith(
        "/Assets", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Green IT</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper" id="appWrapper">

        <aside class="sidebar" id="sidebar">
            <a asp-page="/Index" class="sidebar-brand">
                <span class="brand-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20.8 3.2C12.1 3.1 6.3 5.4 4 10.2c-1.5 3.1.2 6.7 3.5 7.2 3.7.6 7.1-2.5 8.3-6.8-2.7 2.1-5.1 3.2-7.5 3.3C10.1 9.8 14.2 6.6 20.8 3.2Z"
                              fill="currentColor"/>
                        <path d="M4 21c2.5-5.5 6.1-8.8 11-11"
                              fill="none" stroke="currentColor"
                              stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </span>
                <span class="brand-text">
                    <strong>Green IT</strong>
                    <small>Resource Efficiency</small>
                </span>
            </a>

            <nav class="sidebar-nav">
                <div class="sidebar-section">
                    <span class="sidebar-label">MAIN MENU</span>

                    <a asp-page="/Index" class="sidebar-link @(isDashboard ? "active" : "")"
                       title="Dashboard">
                        <span class="menu-icon">▦</span>
                        <span class="menu-text">Dashboard</span>
                    </a>
                </div>

                <div class="sidebar-section">
                    <span class="sidebar-label">MANAGEMENT</span>

                    <a asp-page="/Assets/Index"
                       class="sidebar-link @(isAssets ? "active" : "")"
                       title="IT Assets">

                        <span class="menu-icon">▣</span>
                        <span class="menu-text">IT Assets</span>

                    </a>

                    <button type="button" class="sidebar-link module-link"
                            data-module="Energy Monitoring" title="Energy Monitoring">
                        <span class="menu-icon">ϟ</span>
                        <span class="menu-text">Energy Monitoring</span>
                        <span class="menu-soon">Soon</span>
                    </button>

                    <button type="button" class="sidebar-link module-link"
                            data-module="Paper and Printing" title="Paper and Printing">
                        <span class="menu-icon">▤</span>
                        <span class="menu-text">Paper & Printing</span>
                        <span class="menu-soon">Soon</span>
                    </button>

                    <button type="button" class="sidebar-link module-link"
                            data-module="Sustainability Actions" title="Sustainability Actions">
                        <span class="menu-icon">✓</span>
                        <span class="menu-text">Sustainability Actions</span>
                        <span class="menu-soon">Soon</span>
                    </button>
                </div>

                <div class="sidebar-section">
                    <span class="sidebar-label">SYSTEM</span>

                    <button type="button" class="sidebar-link module-link"
                            data-module="Reports" title="Reports">
                        <span class="menu-icon">▧</span>
                        <span class="menu-text">Reports</span>
                        <span class="menu-soon">Soon</span>
                    </button>

                    <button type="button" class="sidebar-link module-link"
                            data-module="Administration" title="Administration">
                        <span class="menu-icon">⚙</span>
                        <span class="menu-text">Administration</span>
                        <span class="menu-soon">Soon</span>
                    </button>
                </div>
            </nav>

            <div class="sidebar-footer">
                <span class="system-status"></span>
                <div class="footer-brand-text">
                    <strong>GreenIT System</strong>
                    <small>Development Environment</small>
                </div>
            </div>
        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="main-area">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="menu-toggle" id="sidebarToggle"
                            type="button" aria-label="Toggle navigation">
                        ☰
                    </button>

                    <div class="topbar-title">
                        <strong>Resource Efficiency Platform</strong>
                        <small>Environmental sustainability monitoring</small>
                    </div>
                </div>

                <div class="topbar-user">
                    <div class="user-avatar">A</div>
                    <div class="user-details">
                        <strong>Administrator</strong>
                        <small>System Administrator</small>
                    </div>
                </div>
            </header>

            <main class="content-area" id="contentArea">
                <div class="page-content">
                    @RenderBody()
                </div>

                <footer class="app-footer">
                    <span>Green IT Project By Nkambwe JM © @DateTime.UtcNow.Year  ISBAT University</span>
                    <span>Green Computing & Resource Efficiency</span>
                </footer>
            </main>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="moduleToast" class="toast" role="status"
             aria-live="polite" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">GreenIT</strong>
                <button type="button" class="btn-close"
                        data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="moduleToastMessage"></div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const wrapper = document.getElementById("appWrapper");
            const sidebar = document.getElementById("sidebar");
            const toggle = document.getElementById("sidebarToggle");
            const backdrop = document.getElementById("sidebarBackdrop");

            function isMobile() {
                return window.matchMedia("(max-width: 850px)").matches;
            }

            function closeMobileSidebar() {
                sidebar.classList.remove("sidebar-open");
                backdrop.classList.remove("show");
            }

            toggle.addEventListener("click", function () {
                if (isMobile()) {
                    sidebar.classList.toggle("sidebar-open");
                    backdrop.classList.toggle("show");
                } else {
                    wrapper.classList.toggle("sidebar-collapsed");
                }
            });

            backdrop.addEventListener("click", closeMobileSidebar);

                window.addEventListener("resize", function () {
                    if (isMobile()) {
                        // Reset desktop collapsed state on mobile
                        wrapper.classList.remove("sidebar-collapsed");
                    } else {
                        // Close mobile drawer when returning to desktop
                        closeMobileSidebar();
                    }
                });

            document.querySelectorAll(".module-link").forEach(function (button) {
                button.addEventListener("click", function () {
                    const moduleName = this.dataset.module;
                    document.getElementById("moduleToastMessage").textContent =
                        moduleName + " is planned and will be enabled in a later development stage.";

                    const toastElement = document.getElementById("moduleToast");
                    bootstrap.Toast.getOrCreateInstance(toastElement).show();

                    if (isMobile()) {
                        closeMobileSidebar();
                    }
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>