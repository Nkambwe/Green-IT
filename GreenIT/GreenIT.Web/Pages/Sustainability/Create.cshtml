@page
@model GreenIT.Web.Pages.Sustainability.CreateModel

@using GreenIT.Domain.Entities

@{
    ViewData["Title"] = "Create Sustainability Action";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h4 class="mb-1">New Sustainability Action</h4>
        <p class="text-muted mb-0">
            Register an environmental sustainability initiative.
        </p>
    </div>

    <a asp-page="./Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Register
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert"></div>

            <h6 class="mb-3">Initiative Information</h6>

            <div class="row g-3 mb-4">
                <div class="col-md-12">
                    <label asp-for="Input.Title" class="form-label">
                        Initiative Title <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Input.Title"
                           maxlength="200"
                           class="form-control"
                           placeholder="Enter initiative title" />

                    <span asp-validation-for="Input.Title"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Input.Description" class="form-label">
                        Description <span class="text-danger">*</span>
                    </label>

                    <textarea asp-for="Input.Description"
                              maxlength="1500"
                              rows="4"
                              class="form-control"
                              placeholder="Describe the initiative and its intended outcome"></textarea>

                    <span asp-validation-for="Input.Description"
                          class="text-danger small"></span>
                </div>
            </div>

            <hr />

            <h6 class="mb-3">Ownership and Priority</h6>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Input.DepartmentId" class="form-label">
                        Department
                    </label>

                    <select asp-for="Input.DepartmentId"
                            asp-items="Model.Departments"
                            class="form-select">
                        <option value="">Organisation-wide</option>
                    </select>

                    <span asp-validation-for="Input.DepartmentId"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.AssignedToUserId" class="form-label">
                        Assigned To
                    </label>

                    <select asp-for="Input.AssignedToUserId"
                            asp-items="Model.Users"
                            class="form-select">
                        <option value="">Unassigned</option>
                    </select>

                    <span asp-validation-for="Input.AssignedToUserId"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Priority" class="form-label">
                        Priority
                    </label>

                    <select asp-for="Input.Priority"
                            asp-items="Html.GetEnumSelectList<SustainabilityPriority>()"
                            class="form-select"></select>

                    <span asp-validation-for="Input.Priority"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Status" class="form-label">
                        Status
                    </label>

                    <select asp-for="Input.Status"
                            asp-items="Html.GetEnumSelectList<SustainabilityActionStatus>()"
                            class="form-select"></select>

                    <span asp-validation-for="Input.Status"
                          class="text-danger small"></span>
                </div>
            </div>

            <hr />

            <h6 class="mb-3">Progress and Timeline</h6>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Input.ProgressPercentage"
                           class="form-label">Progress (%)</label>

                    <input asp-for="Input.ProgressPercentage"
                           type="number"
                           min="0"
                           max="100"
                           class="form-control" />

                    <span asp-validation-for="Input.ProgressPercentage"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.StartDate" class="form-label">
                        Start Date
                    </label>

                    <input asp-for="Input.StartDate"
                           type="date"
                           asp-format="{0:yyyy-MM-dd}"
                           class="form-control" />

                    <span asp-validation-for="Input.StartDate"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.TargetDate" class="form-label">
                        Target Date
                    </label>

                    <input asp-for="Input.TargetDate"
                           type="date"
                           asp-format="{0:yyyy-MM-dd}"
                           class="form-control" />

                    <span asp-validation-for="Input.TargetDate"
                          class="text-danger small"></span>
                </div>
            </div>

            <hr />

            <h6 class="mb-3">Additional Information</h6>

            <div class="mb-4">
                <label asp-for="Input.Notes" class="form-label">
                    Notes
                </label>

                <textarea asp-for="Input.Notes"
                          maxlength="1000"
                          rows="3"
                          class="form-control"
                          placeholder="Additional comments or observations"></textarea>

                <span asp-validation-for="Input.Notes"
                      class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-page="./Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i>
                    Create Action
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
