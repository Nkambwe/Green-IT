@page "{id:int}"
@model GreenIT.Web.Pages.Sustainability.EditModel

@{
    ViewData["Title"] = "Edit Sustainability Action";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Edit Sustainability Action</h3>
            <p class="text-muted mb-0">
                Update initiative details, ownership and progress.
            </p>
        </div>

        <a asp-page="Details"
           asp-route-id="@Model.Input.Id"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Details
        </a>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form method="post"
                  asp-route-id="@Model.Input.Id">

                <input type="hidden" asp-for="Input.Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <!-- ACTION DETAILS -->

                <h5 class="mb-3">Action Details</h5>

                <div class="row g-3">

                    <div class="col-md-12">
                        <label asp-for="Input.Title"
                               class="form-label">
                            Action Title
                        </label>

                        <input asp-for="Input.Title"
                               class="form-control"
                               placeholder="Enter action title" />

                        <span asp-validation-for="Input.Title"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Input.Description"
                               class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Input.Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe the sustainability initiative"></textarea>

                        <span asp-validation-for="Input.Description"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <!-- OWNERSHIP -->

                <h5 class="mb-3">Ownership and Assignment</h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Input.DepartmentId"
                               class="form-label">
                            Department
                        </label>

                        <select asp-for="Input.DepartmentId"
                                asp-items="Model.Departments"
                                class="form-select">
                            <option value="">Organisation-wide</option>
                        </select>

                        <span asp-validation-for="Input.DepartmentId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.AssignedToUserId"
                               class="form-label">
                            Assigned To
                        </label>

                        <select asp-for="Input.AssignedToUserId"
                                asp-items="Model.Users"
                                class="form-select">
                            <option value="">Unassigned</option>
                        </select>

                        <span asp-validation-for="Input.AssignedToUserId"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <!-- PRIORITY AND STATUS -->

                <h5 class="mb-3">Priority and Progress</h5>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label asp-for="Input.Priority"
                               class="form-label">
                            Priority
                        </label>

                        <select asp-for="Input.Priority"
                                asp-items="Html.GetEnumSelectList<GreenIT.Domain.Enums.SustainabilityPriority>()"
                                class="form-select">
                        </select>

                        <span asp-validation-for="Input.Priority"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Input.Status"
                               class="form-label">
                            Status
                        </label>

                        <select asp-for="Input.Status"
                                asp-items="Html.GetEnumSelectList<GreenIT.Domain.Enums.SustainabilityActionStatus>()"
                                class="form-select">
                        </select>

                        <span asp-validation-for="Input.Status"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Input.ProgressPercentage"
                               class="form-label">
                            Progress (%)
                        </label>

                        <input asp-for="Input.ProgressPercentage"
                               type="number"
                               min="0"
                               max="100"
                               class="form-control" />

                        <span asp-validation-for="Input.ProgressPercentage"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <!-- TIMELINE -->

                <h5 class="mb-3">Timeline</h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Input.StartDate"
                               class="form-label">
                            Start Date
                        </label>

                        <input asp-for="Input.StartDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Input.StartDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.TargetDate"
                               class="form-label">
                            Target Completion Date
                        </label>

                        <input asp-for="Input.TargetDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Input.TargetDate"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <!-- NOTES -->

                <div class="mb-4">
                    <label asp-for="Input.Notes"
                           class="form-label">
                        Notes
                    </label>

                    <textarea asp-for="Input.Notes"
                              class="form-control"
                              rows="3"
                              placeholder="Additional notes (optional)"></textarea>

                    <span asp-validation-for="Input.Notes"
                          class="text-danger"></span>
                </div>

                <!-- ACTION BUTTONS -->

                <div class="d-flex justify-content-end gap-2">

                    <a asp-page="Details"
                       asp-route-id="@Model.Input.Id"
                       class="btn btn-light border">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
