@page
@model GreenIT.Web.Pages.Sustainability.IndexModel

@using GreenIT.Domain.Entities

@{
    ViewData["Title"] = "Sustainability Actions";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h4 class="mb-1">Sustainability Actions</h4>
        <p class="text-muted mb-0">
            Monitor and track organisational environmental initiatives.
        </p>
    </div>

    <a asp-page="./Create" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i>
        New Sustainability Action
    </a>
</div>

@if (TempData["SuccessMessage"] != null) {
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Total Actions</div>
                <h3 class="mb-0 mt-2">@Model.TotalActions</h3>
                <i class="bi bi-list-check text-success"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Completed</div>
                <h3 class="mb-0 mt-2">@Model.CompletedActions</h3>
                <i class="bi bi-check-circle text-success"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">In Progress</div>
                <h3 class="mb-0 mt-2">@Model.InProgressActions</h3>
                <i class="bi bi-arrow-repeat text-primary"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Overdue</div>
                <h3 class="mb-0 mt-2">@Model.OverdueActions</h3>
                <i class="bi bi-clock-history text-danger"></i>
            </div>
        </div>
    </div>

</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">

        <form method="get">
            <div class="row g-3 align-items-end">

                <div class="col-lg-3">
                    <label class="form-label">Search</label>
                    <input asp-for="SearchTerm"
                           class="form-control"
                           placeholder="Title or description..." />
                </div>

                <div class="col-lg-3">
                    <label class="form-label">Department</label>
                    <select asp-for="DepartmentFilter"
                            asp-items="Model.Departments"
                            class="form-select">
                        <option value="">All Departments</option>
                    </select>
                </div>

                <div class="col-lg-2">
                    <label class="form-label">Priority</label>
                    <select asp-for="PriorityFilter"
                            asp-items="Html.GetEnumSelectList<SustainabilityPriority>()"
                            class="form-select">
                        <option value="">All Priorities</option>
                    </select>
                </div>

                <div class="col-lg-2">
                    <label class="form-label">Status</label>
                    <select asp-for="StatusFilter"
                            asp-items="Html.GetEnumSelectList<SustainabilityActionStatus>()"
                            class="form-select">
                        <option value="">All Statuses</option>
                    </select>
                </div>

                <div class="col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-success flex-fill">
                        <i class="bi bi-search"></i>
                        Filter
                    </button>

                    <a asp-page="./Index"
                       class="btn btn-outline-secondary"
                       title="Clear filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>

            </div>
        </form>

    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0">Initiative Register</h6>
            <span class="text-muted small">
                @Model.Actions.Count of @Model.TotalActions displayed
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Initiative</th>
                    <th>Department</th>
                    <th>Priority</th>
                    <th>Progress</th>
                    <th>Status</th>
                    <th>Target Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Actions.Any()) {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No sustainability actions found.
                        </td>
                    </tr>
                } else {
                    @foreach (var item in Model.Actions) {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.Title</div>
                                <small class="text-muted">
                                    @item.StartDate.ToString("dd MMM yyyy")
                                </small>
                            </td>

                            <td>
                                @(item.Department?.Name ?? "Organisation-wide")
                            </td>

                            <td>
                                @switch (item.Priority) {
                                    case SustainabilityPriority.Critical:
                                        <span class="badge bg-danger">Critical</span>
                                        break;
                                    case SustainabilityPriority.High:
                                        <span class="badge bg-warning text-dark">High</span>
                                        break;
                                    case SustainabilityPriority.Medium:
                                        <span class="badge bg-info text-dark">Medium</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">Low</span>
                                        break;
                                }
                            </td>

                            <td style="min-width:130px">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>@item.ProgressPercentage%</span>
                                </div>
                                <div class="progress" style="height:7px">
                                    <div class="progress-bar bg-success"
                                         role="progressbar"
                                         style="width:@(item.ProgressPercentage)%"
                                         aria-valuenow="@item.ProgressPercentage"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </td>

                            <td>
                                @switch (item.Status) {
                                    case SustainabilityActionStatus.Completed:
                                        <span class="badge bg-success">Completed</span>
                                        break;
                                    case SustainabilityActionStatus.InProgress:
                                        <span class="badge bg-primary">In Progress</span>
                                        break;
                                    case SustainabilityActionStatus.OnHold:
                                        <span class="badge bg-warning text-dark">On Hold</span>
                                        break;
                                    case SustainabilityActionStatus.Cancelled:
                                        <span class="badge bg-secondary">Cancelled</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark border">Not Started</span>
                                        break;
                                }
                            </td>

                            <td>
                                @if (item.TargetDate.HasValue) {
                                    <span>@item.TargetDate.Value.ToString("dd MMM yyyy")</span>

                                    @if (item.TargetDate.Value.Date < DateTime.Today &&
                                         item.Status != SustainabilityActionStatus.Completed &&
                                         item.Status != SustainabilityActionStatus.Cancelled) {
                                        <span class="badge bg-danger ms-1">Overdue</span>
                                    }
                                } else {
                                    <span class="text-muted">Not set</span>
                                }
                            </td>

                            <td class="text-end text-nowrap">
                                <a asp-page="./Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-page="./Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-success"
                                   title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-page="./Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1) {
        <div class="card-footer bg-white">
            <nav>
                <ul class="pagination pagination-sm justify-content-end mb-0">

                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="./Index"
                           asp-route-PageNumber="@(Model.PageNumber - 1)"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-DepartmentFilter="@Model.DepartmentFilter"
                           asp-route-PriorityFilter="@Model.PriorityFilter"
                           asp-route-StatusFilter="@Model.StatusFilter">
                            Previous
                        </a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">
                            Page @Model.PageNumber of @Model.TotalPages
                        </span>
                    </li>

                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="./Index"
                           asp-route-PageNumber="@(Model.PageNumber + 1)"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-DepartmentFilter="@Model.DepartmentFilter"
                           asp-route-PriorityFilter="@Model.PriorityFilter"
                           asp-route-StatusFilter="@Model.StatusFilter">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        </div>
    }
</div>
